APP_ENV=development

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Shared webhook secret (NOT the bot token). Required on Vercel/production.
TELEGRAM_WEBHOOK_SECRET=
# Explicit inbound transport: polling (local dev) | webhook (production/Vercel).
# Anything other than a local APP_ENV defaults to webhook.
TELEGRAM_MODE=polling

# Public base URL of the deployment (used by scripts/set_telegram_webhook.py)
PUBLIC_BASE_URL=https://your-app.vercel.app

TIMEZONE=Asia/Kolkata
BRIEFING_TIME=19:00

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
# Serverless token storage: paste the JSON from GET /auth/google/token (local)
# so Vercel can access Google without a writable filesystem. Leave blank locally.
GOOGLE_TOKEN_JSON=

# Optional comma-separated YouTube channel IDs (UCxxxx,...)
YOUTUBE_CHANNEL_IDS=

# Optional LLM (openai | groq | gemini | none)
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
